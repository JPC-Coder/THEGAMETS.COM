          <div className="hero-actions">
            <a className="button button-primary" href="#collection">Explore 70+ Cards <span aria-hidden="true">↘</span></a>
            <button className="button button-quiet" onClick={() => setPackageFlipped((flipped) => !flipped)}>Flip package</button>
          </div>
          <dl className="hero-stats">

const CARD_ACCENTS = [
  "#e6a914", "#08bfc2", "#ff7a1a", "#ff4f9b", "#d89b55", "#ef79b5", "#5db8ff", "#ff9a19", "#d26b22", "#ff3eaa",
  "#ed4a24", "#c7a26d", "#35a8e0", "#b78b5b", "#ff5b17", "#25c9bf", "#2ca6ff", "#8f56e8", "#ff6b16", "#e93791",
  "#f6cf25", "#ed7a23", "#a933ff", "#ffb12b", "#c8d7dc", "#2dd7e8", "#e744d7", "#ff6719", "#9dcc27", "#d9e6ee",
  "#f04cff", "#ff7a19", "#2688ff", "#22c7b5", "#ff4fd2", "#ff7020", "#a348ff", "#ef375f", "#d52424", "#416dff",
  "#d09a67", "#e2b16b", "#e51f25", "#d38a13", "#49a9ff", "#df3126", "#d87520", "#ff9c21", "#ee4fa7", "#f2b51e",
];

const RARITY_CYCLE: Rarity[] = [
  "Common", "Common", "Uncommon", "Common", "Rare",
  "Uncommon", "Common", "Rare", "Uncommon", "Common",
];

const CARDS: Card[] = CARD_NAMES.map((name, index) => {
  const id = index + 1;
  let rarity = RARITY_CYCLE[index % RARITY_CYCLE.length];
  if ([10, 20, 30, 40, 45, 47].includes(id)) rarity = "Ultra Rare";
  if ([8, 14, 43].includes(id)) rarity = "Rare";
  if ([48, 49].includes(id)) rarity = "Legendary";
  if (id === 50) rarity = "Common";
  const value = id === 14 ? 17 : 1;
  const rating = Math.min(10, 3 + Math.ceil(value / 27));

  return {
    uid: `standard-${id}`,
    id,
    name,
    rarity,
    value,
    rating,
    frontImage: `./assets/cards/card-${String(id).padStart(2, "0")}-front.webp?v=2026-august-update`,
    story: CARD_STORIES[index],
    accent: CARD_ACCENTS[index],
  };
});


const SKETCH_SERIES_IMAGES: Record<number, string> = {
  5: "card-05-sketch.jpg",
  6: "card-06-sketch.jpg",
  14: "card-14-sketch.jpg",
  28: "card-28-sketch.jpg",
  45: "card-45-sketch.jpg",
  49: "card-49-sketch.jpg",
};

const DISPLAY_CARDS: Card[] = CARDS.flatMap((card) => {
  const specialImage = HOLOGRAPHIC_IMAGES[card.id];
  const sketchImage = SKETCH_SERIES_IMAGES[card.id];
  const variants: Card[] = [card];

  if (specialImage) variants.push({
      ...card,
      uid: `holographic-${card.id}`,
      rarity: "Legendary",
      value: card.id === 14 ? 24.00 : card.id === 43 ? 7.80 : 6.50,
      rating: [14, 43].includes(card.id) ? 10 : 8,
      frontImage: `./assets/cards/holographic/${specialImage}`,
      variant: card.id === 14 ? "Diamond Rare" : "Holographic",
    });

  if (sketchImage) variants.push({
      ...card,
      uid: `sketch-series-${card.id}`,
      rarity: "Legendary",
      value: 10.99,
      rating: 10,
      frontImage: `./assets/cards/sketch-series/${sketchImage}`,
      variant: "Sketch Series",
    });

  return variants;
});

const BACK_IMAGE = "./assets/cards/JPC%202026%20BACK%20CARD%20LOGO.jpg?v=2026-jpc-official";
const STORAGE_KEY = "gamets-first-series-collected-v1";

function Mark({ children }: { children: React.ReactNode }) {
  return <span className="eyebrow">{children}</span>;
}

function Logo() {
  return (
    <a className="brand" href="#top" aria-label="GAMETS First Series home">
      {/* eslint-disable-next-line @next/next/no-img-element */}
      <img className="brand-main" src="./assets/branding/gamets-header-logo.png" alt="GAMETS" />
      <span className="brand-sub">FIRST SERIES / 2026</span>
    </a>
  );
}

function CardArtwork({ card, side, modal = false }: { card: Card; side: "front" | "back"; modal?: boolean }) {
  const [missing, setMissing] = useState(false);
  const src = side === "back" ? BACK_IMAGE : card.frontImage;

  useEffect(() => setMissing(false), [src]);

  return (
    <div className={`artwork artwork-${side} rarity-${card.rarity.toLowerCase().replaceAll(" ", "-")} ${modal ? "artwork-modal" : ""}`}>
      {!missing && (
        // eslint-disable-next-line @next/next/no-img-element
        <img
          src={src}
          alt={side === "front" ? `${card.name}, GAMETS card ${card.id} front` : "Official GAMETS shared card back"}
          onError={() => setMissing(true)}
        />
      )}
      {missing && side === "front" && (
        <div className="placeholder-art" aria-label={`Placeholder for card ${card.id} front image`}>
          <span className="placeholder-orbit" />
          <strong>GAMETS</strong>
          <small>CARD ARTWORK</small>
          <code>card-{String(card.id).padStart(2, "0")}-front.webp</code>
        </div>
      )}
      <span className="card-index">#{String(card.id).padStart(2, "0")}</span>
      <span className="card-series">FIRST SERIES</span>
    </div>
  );
}

export default function Home() {
  const [collected, setCollected] = useState<number[]>([]);
  const [hydrated, setHydrated] = useState(false);
  const [query, setQuery] = useState("");
  const [rarity, setRarity] = useState("All rarities");
  const [status, setStatus] = useState("All cards");
  const [sort, setSort] = useState("Number: low to high");
  const [pageSize, setPageSize] = useState(DISPLAY_CARDS.length);
  const [flipped, setFlipped] = useState<string[]>([]);
  const [selected, setSelected] = useState<Card | null>(null);
  const [storyCard, setStoryCard] = useState<Card | null>(null);
  const [modalSide, setModalSide] = useState<"front" | "back">("front");
  const [notice, setNotice] = useState("");
  const [packageFlipped, setPackageFlipped] = useState(false);

  useEffect(() => {
    try {
      const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
      if (Array.isArray(stored)) setCollected(stored.filter((id) => Number.isInteger(id) && id >= 1 && id <= 50));
    } catch {
      // Invalid local state is safely ignored.
    }
    setHydrated(true);
  }, []);

  useEffect(() => {
    if (hydrated) localStorage.setItem(STORAGE_KEY, JSON.stringify(collected));
  }, [collected, hydrated]);

  useEffect(() => {
    if (!selected) return;
    const onKey = (event: globalThis.KeyboardEvent) => {
      if (event.key === "Escape") setSelected(null);
      if (event.key === "ArrowRight") {
        const currentIndex = DISPLAY_CARDS.findIndex((card) => card.uid === selected.uid);
        const next = DISPLAY_CARDS[(currentIndex + 1) % DISPLAY_CARDS.length];
        setSelected(next);
        setModalSide("front");
      }
      if (event.key === "ArrowLeft") {
        const currentIndex = DISPLAY_CARDS.findIndex((card) => card.uid === selected.uid);
        const previous = DISPLAY_CARDS[(currentIndex - 1 + DISPLAY_CARDS.length) % DISPLAY_CARDS.length];
        setSelected(previous);
        setModalSide("front");
      }
    };
    document.addEventListener("keydown", onKey);
    document.body.classList.add("modal-open");
    return () => {
      document.removeEventListener("keydown", onKey);
      document.body.classList.remove("modal-open");
    };
  }, [selected]);

  useEffect(() => {
    if (!storyCard) return;
    const onKey = (event: globalThis.KeyboardEvent) => {
      if (event.key === "Escape") setStoryCard(null);
    };
    document.addEventListener("keydown", onKey);
    document.body.classList.add("modal-open");
    return () => {
      document.removeEventListener("keydown", onKey);
      document.body.classList.remove("modal-open");
    };
  }, [storyCard]);

  const filteredCards = useMemo(() => {
    const normalizedQuery = query.trim().toLowerCase();
    const output = DISPLAY_CARDS.filter((card) => {
      const matchesQuery = !normalizedQuery || card.name.toLowerCase().includes(normalizedQuery) || String(card.id).includes(normalizedQuery);
      const matchesRarity = rarity === "All rarities" || card.rarity === rarity;
      const isCollected = collected.includes(card.id);
      const matchesStatus = status === "All cards" || (status === "Collected" ? isCollected : !isCollected);
      return matchesQuery && matchesRarity && matchesStatus;
    });

    return [...output].sort((a, b) => {
      if (sort === "Number: high to low") return b.id - a.id;
      if (sort === "Value: high to low") return b.value - a.value;
      if (sort === "Value: low to high") return a.value - b.value;
      if (sort === "Rarity") return b.rating - a.rating || a.id - b.id;
      return a.id - b.id;
    });
  }, [query, rarity, status, sort, collected]);

  const visibleCards = filteredCards.slice(0, pageSize);
  const collectionValue = CARDS.filter((card) => collected.includes(card.id)).reduce((sum, card) => sum + card.value, 0);
  const progress = (collected.length / CARDS.length) * 100;

  const toggleCollected = (id: number) => {
    setCollected((current) => current.includes(id) ? current.filter((item) => item !== id) : [...current, id]);
  };

  const toggleFlip = (uid: string) => {
    setFlipped((current) => current.includes(uid) ? current.filter((item) => item !== uid) : [...current, uid]);
  };

  const openCard = (card: Card) => {
    setSelected(card);
    setModalSide("front");
  };

  const handleInquiry = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setNotice("Request saved. Connect this form to your store email or checkout service before launch.");
    (event.currentTarget as HTMLFormElement).reset();
